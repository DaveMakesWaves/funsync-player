# Dependencies
node_modules/

# Build output
dist/
build/
backend-dist/

# Python
backend/__pycache__/
backend/.venv/
backend/*.pyc
*.pyc

# Environment / secrets
.env
.env.*

# Logs
*.log

# Runtime caches
thumbs/
scripts_cache/
.funsync/

# Bundled binaries (not checked in — download separately)
ffmpeg/*.exe
ffmpeg/*.zip

# Test media files (too large for git)
Test.mp4
Test-slow.funscript
Logo.ico
FS(1).png
ffmpeg-linux/*.zip
eroscripts-debug.log

# Claude Code
.claude/
notes/

# Release-stats snapshots (scripts/release-stats.sh output).
# Default dir is notes/release-stats/ which is already covered by
# notes/ above; these patterns cover the case where someone runs the
# script with a custom outdir.
release-stats-*.json
release-stats-latest.json
release-stats/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
